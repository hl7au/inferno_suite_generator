require 'inferno_suite_generator/test_modules/update_test'
<% if references_mapping_should_be_shown? %>
require 'inferno_suite_generator/utils/references_keeper'
<% end %>

module <%= suite_module_name %>
  module <%= module_name %>
    class <%= class_name %> < Inferno::Test
      include InfernoSuiteGenerator::UpdateTest

      title '(<%= conformance_expectation %>) Server returns correct <%= resource_type %> resource from <%= resource_type %> update interaction (<%= humanized_option %>).'
      description 'A server <%= conformance_expectation %> support the <%= resource_type %> update interaction (<%= humanized_option %>).'
      <% if optional? %>
      optional
      <% end %>

      <% if references_mapping_should_be_shown? %>
      input :references_mapping_input,
            title: 'References Mapping',
            description: 'Mapping of references for the update resource. Format: ["Patient/patient_id1", "Encounter/encounter_id1"]',
            type: 'textarea',
            optional: true
      <% end %>

      id :<%= test_id %>

        def resource_type
          '<%= resource_type %>'
        end

      def self.demodata
        @demodata ||= InfernoSuiteGenerator::Generator::IGDemodata.new(
          YAML.load_file(File.join(File.dirname(__dir__), 'demodata.yml'), aliases: true)
        )
      end

      def self.metadata
        @metadata ||= InfernoSuiteGenerator::Generator::GroupMetadata.new(YAML.load_file(File.join(__dir__, 'metadata.yml'), aliases: true))
      end

      <% if references_mapping_should_be_shown? %>
      def references_keeper
        @references_keeper ||= InfernoSuiteGenerator::ReferencesKeeper.get_or_create_instance(url)
      end
      <% end %>

      def resource_to_create_filter
        <% if resource_to_create_filter %>
        # This is a FHIRPath expression used to filter the resource payload for update (UpdateNew).
        '<%= resource_to_create_filter %>'
        <% else %>
        nil
        <% end %>
      end

      run do
        <%= executor %>
      end
    end
  end
end
