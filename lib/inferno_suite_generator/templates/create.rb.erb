require 'inferno_suite_generator/test_modules/create_test'
require 'inferno_suite_generator/utils/references_keeper'

module <%= suite_module_name %>
  module <%= module_name %>
    class <%= class_name %> < Inferno::Test
      include InfernoSuiteGenerator::CreateTest

      title '(<%= conformance_expectation %>) Server returns correct <%= resource_type %> resource from <%= resource_type %> create interaction'
      description 'A server <%= conformance_expectation %> support the <%= resource_type %> create interaction.'

      <% if references_mapping_should_be_shown? %>
      input :references_mapping_input,
            title: 'References Mapping',
            description: 'Mapping of references to the create resource. Format: ["Patient/patient_id1", "Medication/medication_id1"]',
            type: 'textarea',
            optional: true
      <% end %>

      id :<%= test_id %>

      def self.demodata
        @demodata ||= InfernoSuiteGenerator::Generator::IGDemodata.new(
          YAML.load_file(File.join(File.dirname(__dir__), 'demodata.yml'), aliases: true)
        )
      end

      def self.metadata
        @metadata ||= InfernoSuiteGenerator::Generator::GroupMetadata.new(
          YAML.load_file(File.join(__dir__, 'metadata.yml'), aliases: true)
        )
      end

      def resource_type
        '<%= resource_type %>'
      end

      def references_keeper
        @rerefences_keeper = InfernoSuiteGenerator::ReferencesKeeper.get_or_create_instance(url)
      end

      def resource_to_create_filter
        <% if resource_to_create_filter %>
        # This is a FHIRPath expression that will be used to filter the resources to create.
        '<%= resource_to_create_filter %>'
        <% else %>
        nil
        <% end %>
      end

      def create_resource_overrides
        <% if create_resource_overrides.any? %>
        {
          <% create_resource_overrides.each do |path, value| %>
          <%= path.inspect %> => <%= value.inspect %>,
          <% end %>
        }
        <% else %>
        {}
        <% end %>
      end

      run do
        perform_create_test
      end
    end
  end
end
