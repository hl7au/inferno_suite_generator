            "extractor_type": "must_support"
          }
        ]
      },
      "http://hl7.org.au/fhir/core/StructureDefinition/au-core-resprate": {
        "register_extractors": [
          {
            "path_to_extractor": "lib/au_core_test_kit/extractors/ms_delete/extractor.rb",
            "extractor_class": "InfernoSuiteGenerator::Generator::MustSupportDeleteExtractor",
            "extractor_type": "must_support"
          }
